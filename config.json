{
  "vlm": {
    "model": "qwen/qwen3-vl-4b",
    "api_base": "http://localhost:1234/v1",
    "api_key_env": ""
  },
  "dashboard": {
    "host": "127.0.0.1",
    "port": 7860,
    "input_dir": "input_videos",
